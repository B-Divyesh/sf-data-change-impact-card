{
  "name": "data-change-impact-card-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build:cli": "cargo build --release",
    "build:site": "vite build --config site/vite.config.ts",
    "build": "npm run build:cli && npm run build:site && npm run pack:cli",
    "preview": "vite preview --config site/vite.config.ts --host 127.0.0.1",
    "test": "cargo test && npm run build:site && playwright test",
    "pack:cli": "cargo package --allow-dirty --no-verify && node scripts/package.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "vite": "7.3.6"
  }
}
